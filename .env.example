# CyberGuardian AI - Environment Configuration
# Copy this file to .env and fill in real values for production use.
# NEVER commit .env — it is in .gitignore.

# --- REQUIRED ---

# JWT secret key for signing access tokens. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
CYBERGUARDIAN_JWT_SECRET=

# Database connection URL (PostgreSQL)
CYBERGUARDIAN_DATABASE_URL=postgresql://postgres:password@localhost:5432/cyberguardianai

# --- OPTIONAL ---

# Google OAuth client ID (for /auth/google endpoint). Leave blank to disable Google sign-in.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# CORS allowed origins (comma-separated). Local dev defaults are applied if unset.
# Example: ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ALLOWED_ORIGINS=

# SMTP configuration for OTP delivery (optional — app simulates OTPs if unset)
CYBERGUARDIAN_SMTP_HOST=smtp.gmail.com
CYBERGUARDIAN_SMTP_PORT=587
CYBERGUARDIAN_SMTP_USERNAME=
CYBERGUARDIAN_SMTP_PASSWORD=
CYBERGUARDIAN_SMTP_FROM_NAME=CyberGuardian AI

# --- TOKEN EXPIRATION ---
ACCESS_TOKEN_EXPIRES_HOURS=24
OTP_EXPIRES_MINUTES=10

# --- RATE LIMITING ---
OTP_RATE_LIMIT=5
OTP_VERIFY_RATE_LIMIT=10
ANALYSIS_RATE_LIMIT=60
COMMUNITY_REPORT_RATE_LIMIT=10

# --- SECURITY BOUNDS ---
MAX_UPLOAD_SIZE=10
MAX_URL_FETCH_TIMEOUT=10.0
MAX_URL_REDIRECTS=5
MAX_RESPONSE_SIZE=10

# --- MODEL INTEGRITY VERIFICATION (Optional for production) ---
# Generate SHA256 hash with: sha256sum <filename>
CYBERGUARDIAN_URL_MODEL_HASH=
CYBERGUARDIAN_MESSAGE_MODEL_HASH=
CYBERGUARDIAN_DEEPFAKE_MODEL_HASH=
